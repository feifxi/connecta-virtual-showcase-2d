# Behind the faculty proxy: https://bscit.sit.kmutt.ac.th${BASE_PATH} → this VM :80 (TLS ends at the faculty proxy)
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  client_max_body_size 60m;           # largest upload (slides 50 MB) + multipart overhead
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;

  # REST api (Better Auth's /api/auth stays in the web app)
  location ${BASE_PATH}/api/v1/ {
    proxy_pass http://api:4000/api/v1/;
    proxy_buffering off;              # stream file downloads
  }

  # Colyseus: HTTP matchmaking + WebSocket, prefix stripped
  location ${BASE_PATH}/realtime/ {
    proxy_pass http://realtime:2567/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;
  }

  # Next.js (basePath = BASE_PATH, so the prefix is kept)
  location ${BASE_PATH}/ {
    proxy_pass http://web:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }

  location = /healthz { return 200 'ok'; }
}
