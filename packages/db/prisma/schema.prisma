// Source of truth for the table design: docs/data-model.md
// Prisma models are PascalCase/camelCase · tables and columns are snake_case via @@map/@map

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------- enums ----------

enum AppRole {
  USER
  PLATFORM_ADMIN

  @@map("app_role")
}

enum EventRole {
  ADMIN
  PRESENTER
  JUDGE

  @@map("event_role")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  LIVE
  EXHIBITION
  ARCHIVED

  @@map("event_status")
}

enum HallOpenMode {
  SCHEDULE
  MANUAL

  @@map("hall_open_mode")
}

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum VisitorType {
  STUDENT
  HIGH_SCHOOL
  COMPANY
  ALUMNI
  PARENT
  TEACHER

  @@map("visitor_type")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invite_status")
}

enum HallSource {
  PRESET
  CUSTOM

  @@map("hall_source")
}

enum FileKind {
  POSTER
  SLIDES
  DOC
  MODEL_3D

  @@map("file_kind")
}

enum FormKind {
  JOIN
  SURVEY

  @@map("form_kind")
}

enum FeedbackStatus {
  VISIBLE
  HIDDEN
  REMOVED

  @@map("feedback_status")
}

enum SheetStatus {
  DRAFT
  SUBMITTED

  @@map("sheet_status")
}

enum AwardKind {
  JUDGES
  AUDIENCE

  @@map("award_kind")
}

enum ReportTarget {
  USER
  CHAT
  FEEDBACK

  @@map("report_target")
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED

  @@map("report_status")
}

// ---------- 1. accounts (Better Auth tables + profile fields) ----------

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String       @unique @db.Citext
  emailVerified Boolean      @default(false) @map("email_verified")
  name          String
  image         String?
  displayName   String?      @map("display_name")
  avatarPreset  Int?         @map("avatar_preset")
  visitorType   VisitorType? @map("visitor_type")
  province      String?
  organization  String?
  position      String?
  appRole       AppRole      @default(USER) @map("app_role")
  onboardedAt   DateTime?    @map("onboarded_at") @db.Timestamptz
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  sessions       Session[]
  accounts       Account[]
  emails         UserEmail[]
  notifications  Notification[]
  subscription   Subscription?
  eventsCreated  Event[]          @relation("EventCreatedBy")
  memberships    EventMember[]    @relation("MemberUser")
  assignedRoles  EventMember[]    @relation("MemberAssignedBy")
  invitesSent    EventInvite[]    @relation("InviteInvitedBy")
  invitesTaken   EventInvite[]    @relation("InviteAcceptedBy")
  interests      EventInterest[]
  attendances    EventAttendee[]
  bans           EventBan[]       @relation("BanUser")
  bansGiven      EventBan[]       @relation("BanBy")
  formResponses  FormResponse[]
  projectMembers ProjectMember[]
  filesUploaded  ProjectFile[]
  feedbacks      Feedback[]
  votes          Vote[]
  contacts       ContactRequest[]
  reportsMade    Report[]         @relation("ReportBy")
  reportsAgainst Report[]         @relation("ReportTarget")
  reportsHandled Report[]         @relation("ReportHandler")
  assignments    JudgeAssignment[]
  scoreSheets    ScoreSheet[]

  @@map("users")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verifications")
}

model Jwks {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz

  @@map("jwks")
}

// other emails a user proved they own (accepted an invite sent there with this account)
model UserEmail {
  userId     String   @map("user_id") @db.Uuid
  email      String   @unique @db.Citext
  verifiedAt DateTime @default(now()) @map("verified_at") @db.Timestamptz
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, email])
  @@map("user_emails")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Subscription {
  userId               String    @id @map("user_id") @db.Uuid
  plan                 Plan
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ---------- 2. events ----------

model Event {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById        String       @map("created_by") @db.Uuid
  slug               String       @unique
  title              String
  description        String       @default("")
  coverKey           String?      @map("cover_key")
  agenda             Json         @default("[]")
  modules            Json         @default("{\"judging\":true,\"popularVote\":true,\"feedback\":true,\"model3d\":false,\"ai\":false}")
  status             EventStatus  @default(DRAFT)
  plan               Plan         @default(FREE)
  capacity           Int
  startsAt           DateTime     @map("starts_at") @db.Timestamptz
  endsAt             DateTime     @map("ends_at") @db.Timestamptz
  hallOpenMode       HallOpenMode @default(SCHEDULE) @map("hall_open_mode")
  exhibitionUntil    DateTime?    @map("exhibition_until") @db.Timestamptz
  resultsAnnouncedAt DateTime?    @map("results_announced_at") @db.Timestamptz
  allowedDomain      String?      @map("allowed_domain")
  boothDeadline      DateTime?    @map("booth_deadline") @db.Timestamptz
  submissionsOpen    Boolean      @default(false) @map("submissions_open")
  entryPaused        Boolean      @default(false) @map("entry_paused")
  suspendedAt        DateTime?    @map("suspended_at") @db.Timestamptz
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  createdBy   User             @relation("EventCreatedBy", fields: [createdById], references: [id])
  categories  EventCategory[]
  members     EventMember[]
  invites     EventInvite[]
  addons      EventAddon[]
  hall        Hall?
  projects    Project[]
  interests   EventInterest[]
  attendees   EventAttendee[]
  bans        EventBan[]
  forms       EventForm[]
  votes       Vote[]
  reports     Report[]
  rubric      Rubric?
  assignments JudgeAssignment[]
  awards      Award[]

  @@index([status, startsAt])
  @@index([createdById])
  @@map("events")
}

model EventCategory {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String    @map("event_id") @db.Uuid
  name     String
  color    String
  sort     Int       @default(0)
  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([eventId, name])
  @@map("event_categories")
}

model EventMember {
  eventId      String      @map("event_id") @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  roles        EventRole[]
  assignedById String?     @map("assigned_by") @db.Uuid
  assignedAt   DateTime    @default(now()) @map("assigned_at") @db.Timestamptz
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User        @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User?       @relation("MemberAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([eventId, userId])
  @@index([userId])
  @@index([roles], type: Gin)
  @@map("event_members")
}

model EventInvite {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  email        String       @db.Citext
  roles        EventRole[]
  projectId    String?      @map("project_id") @db.Uuid
  tokenHash    String       @unique @map("token_hash")
  status       InviteStatus @default(PENDING)
  invitedById  String       @map("invited_by") @db.Uuid
  acceptedById String?      @map("accepted_by") @db.Uuid
  expiresAt    DateTime     @map("expires_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  acceptedAt   DateTime?    @map("accepted_at") @db.Timestamptz
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  acceptedBy   User?        @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([eventId, status])
  @@index([email, status])
  @@map("event_invites")
}

model EventAddon {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId             String   @map("event_id") @db.Uuid
  boughtById          String   @map("bought_by") @db.Uuid
  extraCapacity       Int      @default(0) @map("extra_capacity")
  extraExhibitionDays Int      @default(0) @map("extra_exhibition_days")
  stripePaymentId     String?  @map("stripe_payment_id")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  event               Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_addons")
}

// ---------- 3. hall · projects · files ----------

model Hall {
  id      String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId String      @unique @map("event_id") @db.Uuid
  source  HallSource  @default(PRESET)
  preset  String?
  mapJson Json        @map("map_json")
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots   BoothSlot[]

  @@map("halls")
}

model BoothSlot {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hallId    String   @map("hall_id") @db.Uuid
  block     String
  fillOrder Int      @map("fill_order")
  x         Int
  y         Int
  w         Int
  h         Int
  label     String
  hall      Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  project   Project?

  @@unique([hallId, fillOrder])
  @@map("booth_slots")
}

model Project {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  categoryId  String?        @map("category_id") @db.Uuid
  boothSlotId String?        @unique @map("booth_slot_id") @db.Uuid
  title       String
  summary     String?
  tags        String[]       @default([])
  coverKey    String?        @map("cover_key")
  videoUrl    String?        @map("video_url")
  links       Json           @default("[]")
  aiEnabled   Boolean        @default(false) @map("ai_enabled")
  version     Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category    EventCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  boothSlot   BoothSlot?     @relation(fields: [boothSlotId], references: [id], onDelete: SetNull)

  members     ProjectMember[]
  files       ProjectFile[]
  chunks      DocChunk[]
  invites     EventInvite[]
  feedbacks   Feedback[]
  votes       Vote[]
  contacts    ContactRequest[]
  assignments JudgeAssignment[]
  scoreSheets ScoreSheet[]
  awards      Award[]

  @@unique([id, eventId])
  @@index([eventId, categoryId])
  @@map("projects")
}

model ProjectMember {
  projectId String  @map("project_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model ProjectFile {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  kind         FileKind
  objectKey    String     @map("object_key")
  mime         String
  sizeBytes    BigInt     @map("size_bytes")
  pageCount    Int?       @map("page_count")
  useForAi     Boolean    @default(false) @map("use_for_ai")
  uploadedById String     @map("uploaded_by") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  chunks       DocChunk[]

  @@index([projectId, kind])
  @@map("project_files")
}

model DocChunk {
  id        BigInt                      @id @default(autoincrement())
  projectId String                      @map("project_id") @db.Uuid
  fileId    String                      @map("file_id") @db.Uuid
  content   String
  embedding Unsupported("vector(1024)")?
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file      ProjectFile                 @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("doc_chunks")
}

// ---------- 4. joining · in the event ----------

model EventInterest {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_interests")
}

model EventAttendee {
  eventId          String      @map("event_id") @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  displayName      String      @map("display_name")
  visitorType      VisitorType @map("visitor_type")
  province         String
  consentMarketing Boolean     @default(false) @map("consent_marketing")
  joinedAt         DateTime    @default(now()) @map("joined_at") @db.Timestamptz
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_attendees")
}

model EventBan {
  eventId    String   @map("event_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  bannedById String   @map("banned_by") @db.Uuid
  reason     String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user       User     @relation("BanUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy   User     @relation("BanBy", fields: [bannedById], references: [id])

  @@id([eventId, userId])
  @@map("event_bans")
}

model EventForm {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String         @map("event_id") @db.Uuid
  kind      FormKind
  fields    Json           @default("[]")
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  responses FormResponse[]

  @@unique([eventId, kind])
  @@map("event_forms")
}

model FormResponse {
  formId    String    @map("form_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  answers   Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  form      EventForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([formId, userId])
  @@map("form_responses")
}

model Feedback {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String         @map("project_id") @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  text        String
  isAnonymous Boolean        @default(false) @map("is_anonymous")
  status      FeedbackStatus @default(VISIBLE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User           @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
  @@map("feedbacks")
}

model Vote {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([eventId, userId, projectId])
  @@index([projectId])
  @@map("votes")
}

model ContactRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  email     String
  phone     String?
  link      String?
  message   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("contact_requests")
}

model Report {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String       @map("event_id") @db.Uuid
  reporterId   String       @map("reporter_id") @db.Uuid
  targetUserId String       @map("target_user_id") @db.Uuid
  targetKind   ReportTarget @map("target_kind")
  targetRef    String?      @map("target_ref")
  snapshot     String?
  reason       String
  status       ReportStatus @default(OPEN)
  handledById  String?      @map("handled_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reporter     User         @relation("ReportBy", fields: [reporterId], references: [id])
  targetUser   User         @relation("ReportTarget", fields: [targetUserId], references: [id])
  handledBy    User?        @relation("ReportHandler", fields: [handledById], references: [id])

  @@index([eventId, status])
  @@map("reports")
}

// ---------- 5. judging ----------

model Rubric {
  id       String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId  String            @unique @map("event_id") @db.Uuid
  lockedAt DateTime?         @map("locked_at") @db.Timestamptz
  event    Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rubricId    String  @map("rubric_id") @db.Uuid
  name        String
  description String  @default("")
  maxScore    Int     @map("max_score")
  weight      Decimal @db.Decimal(5, 2)
  sort        Int     @default(0)
  rubric      Rubric  @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores      Score[]

  @@map("rubric_criteria")
}

model JudgeAssignment {
  eventId   String  @map("event_id") @db.Uuid
  judgeId   String  @map("judge_id") @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  judge     User    @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId, eventId], references: [id, eventId], onDelete: Cascade)

  @@id([judgeId, projectId])
  @@index([eventId])
  @@map("judge_assignments")
}

model ScoreSheet {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  judgeId        String      @map("judge_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  status         SheetStatus @default(DRAFT)
  comment        String?
  commentVisible Boolean     @default(true) @map("comment_visible")
  version        Int         @default(1)
  submittedAt    DateTime?   @map("submitted_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  judge          User        @relation(fields: [judgeId], references: [id])
  project        Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scores         Score[]

  @@unique([judgeId, projectId])
  @@index([projectId])
  @@map("score_sheets")
}

model Score {
  sheetId     String          @map("sheet_id") @db.Uuid
  criterionId String          @map("criterion_id") @db.Uuid
  score       Decimal         @db.Decimal(6, 2)
  sheet       ScoreSheet      @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@id([sheetId, criterionId])
  @@map("scores")
}

model Award {
  eventId   String    @map("event_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  kind      AwardKind
  rank      Int
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([eventId, kind, rank])
  @@map("awards")
}

// ---------- 6. analytics · logs (no FKs: written fast, deleted by the event service) ----------

model PresenceSession {
  id       BigInt    @id @default(autoincrement())
  eventId  String    @map("event_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt   DateTime? @map("left_at") @db.Timestamptz

  @@index([eventId, joinedAt])
  @@map("presence_sessions")
}

model BoothVisit {
  id        BigInt    @id @default(autoincrement())
  eventId   String    @map("event_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  enteredAt DateTime  @default(now()) @map("entered_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  @@index([projectId, userId])
  @@index([eventId])
  @@map("booth_visits")
}

model HeatmapCount {
  eventId String   @map("event_id") @db.Uuid
  cellX   Int      @map("cell_x")
  cellY   Int      @map("cell_y")
  minute  DateTime @db.Timestamptz
  samples Int

  @@id([eventId, cellX, cellY, minute])
  @@map("heatmap_counts")
}

model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  eventId   String   @map("event_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  type      String
  projectId String?  @map("project_id") @db.Uuid
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventId, type, createdAt])
  @@map("analytics_events")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  eventId   String?  @map("event_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  targetId  String?  @map("target_id")
  reason    String?
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventId, createdAt])
  @@map("audit_logs")
}
