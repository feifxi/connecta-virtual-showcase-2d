# Copy to .env at the repo root · every app reads this file in dev · values match infra/docker-compose.dev.yml
# Public origin of the site (prod: https://bscit.sit.kmutt.ac.th) and the path it lives under (prod: /capstone26/CP26SSI3)
APP_ORIGIN=http://localhost:3000
BASE_PATH=

DATABASE_URL=postgresql://connecta:connecta@localhost:5432/connecta

# Better Auth (apps/web) · generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-dev-secret-at-least-32-characters
# OAuth (optional in dev · magic link always works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email (dev: Mailpit · prod: Gmail SMTP + app password)
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Connecta <no-reply@connecta.local>"

# API (apps/api)
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
# Signs hall tickets for the realtime server · openssl rand -base64 32
HALL_TICKET_SECRET=change-me-hall-ticket-secret
# Shared secret for realtime → api calls (analytics, booth state)
INTERNAL_API_TOKEN=change-me-internal-token

# Realtime (apps/realtime)
REALTIME_PORT=2567
# URL the browser uses to reach Colyseus (prod: wss://<host><BASE_PATH>/realtime)
PUBLIC_REALTIME_URL=ws://localhost:2567

# LiveKit (dev values match --dev mode)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Object storage (S3 API · dev: SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=connecta
S3_SECRET_KEY=connecta-secret
S3_BUCKET=connecta

REDIS_URL=redis://localhost:6379

# AI (optional · empty = AI features answer 503)
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
