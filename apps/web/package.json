    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  }
