{
  "name": "@connecta/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev --port 3000",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
