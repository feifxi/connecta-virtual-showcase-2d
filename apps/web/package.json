  },
  "dependencies": {
    "@colyseus/sdk": "0.18.8",
    "@connecta/db": "*",
    "@connecta/shared": "*",
    "@hookform/resolvers": "^6.0.1",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "livekit-client": "2.22.4",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "openapi-fetch": "^0.17.0",
    "phaser": "4.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
